# Copy to .env.production, chmod 600. Never commit populated file.
COMPOSE_PROJECT_NAME=exam
# Generate each password/key independently: openssl rand -hex 32
MYSQL_DATABASE=exam
MYSQL_USER=exam
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
JWT_SECRET=
CSRF_SECRET=
APP_ENV=production
DB_POOL_MAX=20
# Leave room for migration, backup and operator connections (one backend only).
MYSQL_MAX_CONNECTIONS=150
# Domain: SITE_ADDRESS=exam.example.org, PUBLIC_ORIGIN=https://exam.example.org
# DNS A/AAAA must point here; open ports 80/443 for automatic HTTPS.
SITE_ADDRESS=:80
PUBLIC_ORIGIN=http://localhost
ACME_EMAIL=
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
AUTH_COOKIE_SECURE=true
# HTTP LAN ONLY: set AUTH_COOKIE_SECURE=false and explicitly opt in below.
# Plain HTTP does not protect names/session cookies; prefer HTTPS in production.
ALLOW_INSECURE_HTTP=false
JWT_EXPIRES_IN=1d
API_RATE_LIMIT_MAX=30000
API_RATE_LIMIT_WINDOW_MS=900000
CANDIDATE_RATE_LIMIT_MAX=600
CANDIDATE_RATE_LIMIT_WINDOW_MS=900000
PARTICIPANT_RATE_LIMIT_MAX=3000
PARTICIPANT_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=50
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
RECEIPT_RATE_LIMIT_MAX=30
RECEIPT_RATE_LIMIT_WINDOW_MS=900000
AUTH_SENSITIVE_RATE_LIMIT_MAX=10
AUTH_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
ATTEMPT_EXPIRY_JOB_ENABLED=true
ATTEMPT_EXPIRY_INTERVAL_MS=10000
ATTEMPT_EXPIRY_MAX_RUN_MS=20000
# Keep false on actual exam server. Load-test only isolated exam_load_test_* DB.
LOAD_TEST_ENABLED=false
LOG_LEVEL=info
# Optional image names for release/pull; default builds from current source.
BACKEND_IMAGE=exam-backend:local
WEB_IMAGE=exam-web:local
# Host backup destination and retention; scripts take env file as first argument.
BACKUP_DIR=./backups
BACKUP_KEEP=14
