{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend hệ thống kiểm tra nhận thức trực tuyến: Express + MySQL + Knex.",
  "packageManager": "pnpm@10.33.3",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test",
    "migrate": "knex migrate:latest --knexfile knexfile.js",
    "migrate:rollback": "knex migrate:rollback --knexfile knexfile.js",
    "migrate:make": "knex migrate:make --knexfile knexfile.js --migrations-directory ./src/database/migrations",
    "test:database": "node --test src/database/*.integration.test.js",
    "load-test": "node scripts/load-test.js",
    "create-admin": "node scripts/create-admin.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.1.0",
    "file-type": "^22.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "knex": "^3.2.10",
    "multer": "^2.5.0",
    "mysql2": "^3.22.3",
    "saxes": "^6.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
