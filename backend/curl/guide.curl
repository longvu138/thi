# Public: đầu mối hỗ trợ, không có cấu hình bí mật
curl -i http://localhost:3108/api/public/guide
# ADMIN: cookie + CSRF từ auth/login (audit log)
curl -i -X PUT http://localhost:3108/api/admin/guide -b '<COOKIE_FILE>' -H 'Content-Type: application/json' -H 'X-CSRF-Token: <CSRF_TOKEN>' --data '{"supportContact":"Ban tổ chức — số điện thoại nội bộ"}'
# 422: kiểu dữ liệu sai
curl -i -X PUT http://localhost:3108/api/admin/guide -b '<COOKIE_FILE>' -H 'Content-Type: application/json' -H 'X-CSRF-Token: <CSRF_TOKEN>' --data '{"supportContact":123}'
# 401: không có phiên
curl -i -X PUT http://localhost:3108/api/admin/guide -H 'Content-Type: application/json' --data '{"supportContact":""}'
# 403: phiên USER + CSRF hợp lệ không có quyền sửa
curl -i -X PUT http://localhost:3108/api/admin/guide -b '<USER_COOKIE_FILE>' -H 'X-CSRF-Token: <USER_CSRF_TOKEN>' -H 'Content-Type: application/json' --data '{"supportContact":""}'
