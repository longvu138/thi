# Môi trường chạy: development hoặc production; node:test tự có NODE_TEST_CONTEXT.
NODE_ENV=development
# Cổng HTTP backend lắng nghe.
PORT=3108

# Địa chỉ, cổng, tài khoản, mật khẩu và tên database MySQL.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=exam
# Pool dev mặc định 3, production mặc định 20; cho phép 1..50.
DB_POOL_MIN=0
DB_POOL_MAX=3
DB_POOL_IDLE_TIMEOUT_MS=30000

# Mức log tối thiểu; kích thước tối đa mỗi file log; thời gian giữ log.
LOG_LEVEL=info
LOG_MAX_SIZE=20m
LOG_RETENTION=30d

# Khóa ký JWT, thời hạn phiên, đơn vị phát hành và đối tượng sử dụng token.
# Tạo khóa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Production từ chối khởi động nếu khóa thiếu, ngắn hơn 32 ký tự, là giá trị mẫu hoặc trùng CSRF_SECRET.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=1d
JWT_ISSUER=exam-backend
JWT_AUDIENCE=exam-web
# Khóa riêng để ký CSRF token, phải khác JWT_SECRET. Local thiếu biến này thì backend tự dẫn xuất
# một khóa riêng từ JWT_SECRET kèm cảnh báo; production bắt buộc cấu hình.
CSRF_SECRET=replace-with-a-separate-random-secret
# Tên cookie chứa JWT. Local không dùng tiền tố __Host- vì chưa chạy HTTPS.
AUTH_COOKIE_NAME=exam_session
# true chỉ gửi cookie qua HTTPS; local HTTP đặt false, production bắt buộc true.
AUTH_COOKIE_SECURE=false
# Chính sách gửi cookie chéo website: strict, lax hoặc none. none bắt buộc Secure=true.
AUTH_COOKIE_SAME_SITE=lax
# Danh sách origin frontend được gọi API, phân tách bằng dấu phẩy; không dùng dấu * khi gửi cookie.
CORS_ALLOWED_ORIGINS=http://localhost:3110,http://localhost:4174
# Số lớp reverse proxy đáng tin trước Node.js; để trống khi chạy trực tiếp, thường là 1 khi qua một Nginx.
TRUST_PROXY=

# Kích thước tối đa của JSON/form body và số tham số form tối đa trong một request.
REQUEST_BODY_LIMIT=1mb
REQUEST_PARAMETER_LIMIT=100
# Rate limit toàn API: cửa sổ thời gian (ms) và số request tối đa theo IP trong cửa sổ đó.
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=30000
# Rate limit đăng nhập: cửa sổ thời gian (ms) và số lần sai tối đa theo IP + username.
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
# Rate limit đăng nhập sai theo riêng IP (mọi username).
LOGIN_IP_RATE_LIMIT_WINDOW_MS=900000
LOGIN_IP_RATE_LIMIT_MAX=50
# Rate limit cho thao tác nhạy cảm của quản trị (tạo/sửa tài khoản, đặt lại mật khẩu).
AUTH_SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
AUTH_SENSITIVE_RATE_LIMIT_MAX=10
# Số phiên đăng nhập còn hiệu lực tối đa cho mỗi tài khoản; phiên cũ hơn tự động bị thu hồi.
MAX_ACTIVE_SESSIONS_PER_USER=10
# Thời gian tối đa chờ đóng kết nối khi backend shutdown trước khi buộc thoát.
SHUTDOWN_TIMEOUT_MS=10000


# Giới hạn vào thi bằng thông tin người dự thi, theo IP (mặc định 3000 lần/15 phút).
PARTICIPANT_RATE_LIMIT_WINDOW_MS=900000
PARTICIPANT_RATE_LIMIT_MAX=3000

# Job hết giờ lượt thi: chỉ khởi động từ server, tắt trong test/migration.
ATTEMPT_EXPIRY_JOB_ENABLED=true
ATTEMPT_EXPIRY_INTERVAL_MS=30000

# Timeout kết nối/pool MySQL (ms), giữ giá trị nhỏ và hữu hạn.
DB_POOL_ACQUIRE_TIMEOUT_MS=30000
DB_POOL_CREATE_TIMEOUT_MS=30000
DB_POOL_REAP_INTERVAL_MS=1000
DB_CONNECT_TIMEOUT_MS=10000
DB_KEEPALIVE_INITIAL_DELAY_MS=0
# Chỉ dùng khi frontend/backend cùng origin qua proxy đáng tin; mặc định tắt.
CORS_ALLOW_SAME_ORIGIN=false
# KHÔNG bật trên server thật. Chỉ bật server local dùng DB exam_load_test_*.
LOAD_TEST_ENABLED=false
# TEST_LOAD_DB_NAME=exam_load_test_local

# Giới hạn dùng chung làm bài/đợt/kết quả/phiếu sau xác thực, theo user id.
CANDIDATE_RATE_LIMIT_WINDOW_MS=900000
CANDIDATE_RATE_LIMIT_MAX=600
RECEIPT_RATE_LIMIT_WINDOW_MS=900000
RECEIPT_RATE_LIMIT_MAX=30
ATTEMPT_EXPIRY_MAX_RUN_MS=20000
# Đường dẫn cấu hình đầu mối hỗ trợ; Docker dùng volume /app/storage.
APP_SETTINGS_FILE=./storage/settings.json
# Chỉ bật rõ ràng cho máy chủ LAN HTTP; HTTPS giữ false.
ALLOW_INSECURE_HTTP=false
