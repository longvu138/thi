# Mẫu tối giản cho hosting Node.js/Passenger, không dùng cho Docker.
# Copy thành .env trên hosting; không ghi đè .env local đang dùng.
NODE_ENV=production
# Không đặt PORT: Passenger cấp cổng/socket cho ứng dụng.

# MySQL: dùng đầy đủ prefix tài khoản cPanel.
DB_HOST=localhost
DB_PORT=3306
DB_USER=<DB_USER>
DB_PASSWORD=<DB_PASSWORD>
DB_NAME=<DB_NAME>
# Giữ pool nhỏ trên shared hosting (production mặc định trong code là 20).
DB_POOL_MIN=0
DB_POOL_MAX=3

# Tạo riêng từng giá trị bằng openssl rand -hex 32; không dùng giá trị mẫu.
JWT_SECRET=replace-with-a-long-random-secret
CSRF_SECRET=replace-with-a-separate-random-secret
AUTH_COOKIE_SECURE=true

# Frontend và API là hai subdomain cùng miền gốc, đều dùng HTTPS.
CORS_ALLOWED_ORIGINS=https://thi.example.vn
# Chỉ dùng 1 nếu hosting xác nhận đúng một proxy tin cậy; sửa theo thực tế.
TRUST_PROXY=1

# Đường dẫn ngoài public_html, ứng dụng cần quyền ghi.
APP_SETTINGS_FILE=/home/cpuser/thi-data/settings.json

# Các cấu hình khác dùng mặc định trong code: SameSite=lax, JWT=1d,
# API=30000/IP/15 phút, người thi=600/user/15 phút, vào thi=3000/IP/15 phút.
# Không bật LOAD_TEST_ENABLED trên database thật.
# Danh sách tùy chọn đầy đủ: backend/.env.example và docs/DEPLOY_HOSTING.md.
