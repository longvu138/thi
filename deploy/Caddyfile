{
 admin off
 email "{$ACME_EMAIL}"
}
{$SITE_ADDRESS::80} {
 encode zstd gzip
 @api path /api /api/*
 handle @api {
  # Caddy overwrites untrusted X-Forwarded-For; Node trusts only this one hop.
  reverse_proxy backend:3108
 }
 handle /assets/* {
  root * /srv
  header Cache-Control "public, max-age=31536000, immutable"
  file_server
 }
 handle {
  root * /srv
  header Cache-Control "no-cache"
  try_files {path} /index.html
  file_server
 }
}
:8080 {
 respond /healthz "ok" 200
}
